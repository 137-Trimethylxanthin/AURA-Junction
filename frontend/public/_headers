# Cloudflare Pages response headers.
# Before deploying, replace https://aura-backend.example.modal.run in connect-src
# with the real Modal web URL (the one `modal deploy` prints). Everything else is fixed.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://aura-backend.example.modal.run; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/drawings/*
  Cache-Control: public, max-age=3600
